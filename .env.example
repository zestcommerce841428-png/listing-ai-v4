# ══════════════════════════════════════════════════════════════════════
# ListingAI v4 — Environment Configuration
# Copy this file to .env.local and fill in your values
# ══════════════════════════════════════════════════════════════════════

# ── Database (MySQL) ────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/listing_ai"

# ── Clerk Authentication ─────────────────────────────────────────────
# Get free keys at https://clerk.com → Create Application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── Super Admin ──────────────────────────────────────────────────────
# Your Clerk User ID — get it from Clerk Dashboard → Users
# Set this AFTER you first sign in so you know your Clerk user ID
SUPER_ADMIN_CLERK_ID=""
SUPER_ADMIN_EMAIL=""

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Redis ────────────────────────────────────────────────────────────
# For local dev without Docker: install Redis or use redis-server
# Default: redis://localhost:6379 (no password)
REDIS_URL="redis://localhost:6379"

# ── Kafka ────────────────────────────────────────────────────────────
# For local dev without Docker, Kafka is optional (queue still works via DB)
KAFKA_BROKERS="localhost:9092"

# ── Python Scraper ───────────────────────────────────────────────────
# Start with: cd python-scraper && python scraper.py
PYTHON_SCRAPER_URL="http://localhost:5001"

# ── AI Providers (users can also enter keys in the UI) ───────────────
# Free: get at console.groq.com (14,400 req/day)
GROQ_API_KEY=""
# Free: get at aistudio.google.com (1,500 req/day)
GEMINI_API_KEY=""
# Paid: get at platform.openai.com
OPENAI_API_KEY=""

# ── AWS Bedrock ──────────────────────────────────────────────────────
# Optional: 44 models including Claude 3.5, Llama 3.3, Nova
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# ── Google ───────────────────────────────────────────────────────────
# Optional: get at search.google.com/search-console
GOOGLE_SITE_VERIFICATION=""
